# Env-var conventions
#   * Server-only vars carry no prefix and are read from `process.env` on the
#     server only. They must NEVER appear in client code, because nothing
#     strips them from the browser bundle.
#   * Client-safe vars use the `VITE_` prefix. Vite statically inlines these
#     into the browser bundle at build time. Treat them as public.
#
# Copy this file to `.env.local` and fill in the real values. `.env.local`
# is gitignored. See `docs/env.md` for details.

# ---- Supabase ---------------------------------------------------------------

# Bare project ref (e.g. `abcdefghijklmnop`). Used by the `supabase` CLI.
SUPABASE_PROJECT_REF=your-project-ref

# Server-only secret. Bypasses RLS — never ship to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# Connection string for migrations and direct server-side DB access.
# Local default points at the Compose stack from `docker/compose.yml`.
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres

# Client-safe Supabase config. The browser uses these via `createClient()`.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# ---- External services (mocked by default in dev) ---------------------------

# When `true`, the GOC verification module returns canned responses instead of
# scraping `str.optical.org`. Local dev defaults to mocked so the regulator's
# website is never hit from a laptop.
GOC_MOCK=true
GOC_API_KEY=

# When `true`, the signup-to-paying-Practitioner flow skips Stripe entirely:
# `startCheckout` synthesises stripe IDs and flips the new Practitioner row
# straight to subscription_status=active. The /api/stripe/webhook handler is
# not exercised in mock mode. Local dev defaults to mocked so a laptop never
# needs Stripe API keys to run the signup flow end-to-end.
VITE_STRIPE_MOCK=true
VITE_STRIPE_PUBLISHABLE_KEY=

# Server-only Stripe secrets. Required once `VITE_STRIPE_MOCK=false`.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# The Stripe Price id for the £29/month MiCare subscription. Created once in
# the Stripe dashboard (test mode) and committed here per environment.
STRIPE_PRICE_ID=

# Origin used to build Stripe Checkout success_url / cancel_url. No trailing
# slash. Local dev uses the Vite dev-server origin.
APP_URL=http://localhost:3000

# ---- Email (Resend) ---------------------------------------------------------

# Required for Notify-Me confirmations, notification emails, and monthly
# summary emails. Local dev can leave this blank — Inbucket on port 54324
# catches anything GoTrue sends.
RESEND_API_KEY=

# ---- Click tracking ---------------------------------------------------------

# Salts the visitor hash stored in `clickthroughs` (Slice 5). The event log
# never holds a raw IP, but an unsalted sha256 of one is reversible — the IPv4
# space is small enough to brute-force. Optional: local dev falls back to a
# fixed insecure constant. Set a long random value per deployed environment.
# Changing it resets every in-flight 24h dedup window.
CLICK_TRACKING_SALT=

# ---- Notify-Me --------------------------------------------------------------

# Signs the confirm / unsubscribe links in Notify-Me emails (Slice 15). No
# token is stored per row — the signature is what makes the link non-guessable,
# and the purpose is baked into it so an unsubscribe link cannot confirm.
# Optional: local dev falls back to a fixed insecure constant. Set a long
# random value per deployed environment. Rotating it invalidates every link
# already sitting in a consumer's inbox.
NOTIFY_TOKEN_SECRET=

# ---- Scheduled jobs (Vercel Cron) -------------------------------------------

# Bearer token Vercel Cron sends on /api/cron/* requests. The routes 401 on a
# mismatch and 500 when unset, so local runs (which have no cron) can leave it
# blank. Set a long random value per deployed environment.
CRON_SECRET=

# When `true` (the default), every email MiCare sends — the daily stale-alert
# digest, the refund-on-revocation notice, the monthly summary, and the
# Notify-Me confirmation — is a structured log line only and no Resend call is
# made, keeping local runs and the test suite offline. The Notify-Me form
# additionally renders its confirm link on screen in this mode, as the mock
# login flow does. Setting it to `false` requires RESEND_API_KEY and
# OPERATOR_ALERT_EMAIL.
ALERT_MOCK=true

# Recipient for the daily stale-verification digest.
OPERATOR_ALERT_EMAIL=

# Visible Practitioners un-reverified for longer than this many days are
# surfaced by the daily stale alert.
STALE_VERIFICATION_DAYS=14

# ---- Operator tooling -------------------------------------------------------

# Bearer token for POST /api/admin/verify-practitioner, the manual re-run for a
# Practitioner stuck in `pending` (ADR-0014). Separate from CRON_SECRET on
# purpose: Vercel injects that one into every scheduled run, this one is typed
# by a human, and rotating either should not disturb the other. The route 401s
# on a mismatch and 500s when unset, so local runs can leave it blank.
OPERATOR_SECRET=
